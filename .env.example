# Copy to .env.local (ignored by git) and fill in. Set the same values in your host's environment settings.

# Gmail account that sends the contact form emails.
SMTP_USER=you@gmail.com
# Gmail App Password (Google Account > Security > 2-Step Verification > App passwords), not your normal password.
SMTP_PASS=xxxxxxxxxxxxxxxx

# Optional: where submissions go. Defaults to the address shown on the site.
CONTACT_RECIPIENT_EMAIL=

# Optional: only needed for a non-Gmail SMTP server.
SMTP_HOST=
SMTP_PORT=
